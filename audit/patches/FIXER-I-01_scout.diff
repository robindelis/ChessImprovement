+    def check_line_overlap(self, repertoire: str, moves: List[Dict]) -> Dict:
+        """Checks if a scouted line or its subline is already present in the user's repertoire."""
+        # Audit SCOUT-10(b): `check_tree` with 200 lines x 50 000 moves (1e7 slots)
+        # burned 262.9 s of CPU in one request. Each ply walks the whole
+        # repertoire index, so the ply count is the multiplier that has to be
+        # bounded. Route-level caps are requested in the hand-off (api.py).
+        if not isinstance(moves, list):
+            raise ValueError("moves must be a list.")
+        if len(moves) > MAX_CHECK_LINE_PLIES:
+            raise ValueError(
+                f"Too many moves in one line ({len(moves)}); the limit is {MAX_CHECK_LINE_PLIES} plies."
+            )
+        rm = RepertoireManager.get_instance()
+        return rm.check_line_overlap(repertoire=repertoire, moves=moves)
