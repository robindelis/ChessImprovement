+    @staticmethod
+    def _sanitize_chapters(raw_chapters: Any, duration: int) -> List[Dict]:
+        """Coerce extractor chapter metadata into a bounded, ordered list.
+
+        Audit SCOUT-15: ``ch.get('start_time', 0)`` was passed straight to
+        ``float()`` and ``None``/``str``/``nan``/``inf``/5000-entry chapter lists
+        all crashed the endpoint. Audit SCOUT-05(d): duplicate / backwards /
+        negative chapter starts silently swallowed every chapter after the first.
+        """
+        if not isinstance(raw_chapters, (list, tuple)):
+            return []
+        cleaned = []
+        for idx, ch in enumerate(raw_chapters[:MAX_CHAPTERS]):
+            if not isinstance(ch, dict):
+                continue
+            start = _safe_float(ch.get('start_time'), 0.0, 0.0, float(duration or MAX_DURATION_SECONDS))
+            end = _safe_float(ch.get('end_time'), float(duration or 0), 0.0,
+                              float(duration or MAX_DURATION_SECONDS))
+            if end < start:
+                end = start
+            cleaned.append({
+                'title': _safe_str(ch.get('title'), f"Chapter {idx + 1}") or f"Chapter {idx + 1}",
+                'start_time': start,
+                'end_time': end,
+                'start_formatted': format_seconds(start),
+            })
+        cleaned.sort(key=lambda c: c['start_time'])
+        return cleaned
