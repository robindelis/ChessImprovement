+def _safe_str(value: Any, default: str = "", max_len: int = MAX_TITLE_CHARS) -> str:
+    """Coerce an extractor/database value to a bounded ``str``.
+
+    ``save_scouted_content`` binds these straight into SQLite and the payload is
+    echoed into the UI, so a ``dict``/``list``/``None`` from the third-party
+    extractor must never reach either (audit SCOUT-15).
+    """
+    if value is None:
+        return default
+    if isinstance(value, str):
+        return value[:max_len]
+    if isinstance(value, bool):
+        return str(value)
+    if isinstance(value, (int, float)):
+        try:
+            if isinstance(value, float) and (math.isnan(value) or math.isinf(value)):
+                return default
+            return str(value)[:max_len]
+        except Exception:
+            return default
+    return default
+
+
+def _safe_float(value: Any, default: float = 0.0, lo: float = 0.0, hi: float = MAX_DURATION_SECONDS) -> float:
+    """Coerce to a finite float inside ``[lo, hi]`` (audit SCOUT-05, SCOUT-15)."""
+    try:
+        if isinstance(value, bool):
+            value = int(value)
+        num = float(value)
+    except (TypeError, ValueError):
+        return default
+    if math.isnan(num) or math.isinf(num):
+        return default
+    if num < lo:
+        return lo
+    if num > hi:
+        return hi
+    return num
+
+
+def _safe_int(value: Any, default: int = 0, lo: int = 0, hi: int = MAX_DURATION_SECONDS) -> int:
+    """Coerce to an int inside ``[lo, hi]`` (audit SCOUT-15: ``duration`` shapes)."""
+    try:
+        if isinstance(value, bool):
+            value = int(value)
+        num = float(value)
+        if math.isnan(num) or math.isinf(num):
+            return default
+        return max(lo, min(hi, int(num)))
+    except (TypeError, ValueError):
+        return default
+
