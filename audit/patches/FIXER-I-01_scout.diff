+    @staticmethod
+    def _looks_like_pgn(text: str) -> bool:
+        """Whether a blob is plausibly PGN movetext (audit SCOUT-08).
+
+        The old dispatcher used ``"1." in source``, so a header-only blob, a JSON
+        string, a mid-game FEN or a plain move list without move numbers all
+        reached the fallback. A FEN-starting PGN (``[SetUp "1"][FEN ...]``) has
+        no literal ``1.`` and was therefore unreachable, so it is accepted too.
+        """
+        if not text or not isinstance(text, str):
+            return False
+        stripped = text.strip()
+        if not stripped:
+            return False
+        has_setup = bool(re.search(r'^\s*\[(SetUp|FEN)\b', stripped, re.IGNORECASE | re.MULTILINE))
+        has_numbered_move = bool(re.search(r'\d+\s*\.{1,3}\s*[KQRBNa-h]?[1-8x]', stripped))
+        if not (has_setup or has_numbered_move):
+            return False
+        if not has_setup:
+            # Reject a headers-only blob: it has no movetext at all.
+            movetext = re.sub(r'\[[^\]]*\]', '', stripped)
+            movetext = re.sub(r'(?m)^\s*%.*$', '', movetext)
+            if not re.search(r'[KQRBNO]?[a-h]?[1-8]?x?[a-h][1-8]|\d+\s*\.', movetext):
+                return False
+        return True
+
