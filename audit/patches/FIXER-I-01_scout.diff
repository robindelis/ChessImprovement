+        with the expected keys, a source type, and at least one variation. The
+        dead pipeline used to persist ``variations: []`` / ``full_timeline: []``
+        for every video, and ``analyze_source`` then served that empty payload
+        for ever, so a single transient failure permanently disabled the Scout.
+        """
+        if not isinstance(data, dict) or not data:
+            return False
+        if data.get('source_type') not in ('youtube', 'eco_guide', 'pgn'):
+            return False
+        if not isinstance(data.get('title'), str):
+            return False
+        variations = data.get('variations')
+        timeline = data.get('full_timeline')
+        if not isinstance(variations, list) or not isinstance(timeline, list):
+            return False
+        if not variations and not timeline:
+            return False
+        return True
 
