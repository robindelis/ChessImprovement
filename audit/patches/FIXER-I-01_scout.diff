+    def check_lines_overlap(self, repertoire: str, lines: List[Dict]) -> List[Dict]:
+        """Batch checks multiple scouted lines against the user's repertoire."""
+        if not isinstance(lines, list):
+            raise ValueError("lines must be a list.")
+        if len(lines) > MAX_CHECK_TREE_LINES:
+            raise ValueError(
+                f"Too many lines ({len(lines)}); the limit is {MAX_CHECK_TREE_LINES}."
+            )
+        total_plies = 0
+        for line in lines:
+            if not isinstance(line, dict):
+                raise ValueError("Each line must be an object with an 'id' and a 'moves' list.")
+            plies = line.get("moves") or []
+            if not isinstance(plies, list):
+                raise ValueError("Each line's 'moves' must be a list.")
+            total_plies += len(plies)
+        if total_plies > MAX_CHECK_TREE_PLIES:
+            raise ValueError(
+                f"Too many moves in one tree check ({total_plies}); the limit is {MAX_CHECK_TREE_PLIES} plies."
+            )
+        rm = RepertoireManager.get_instance()
+        return rm.check_lines_overlap(repertoire=repertoire, lines=lines)
